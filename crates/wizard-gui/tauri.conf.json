{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoreInfra Wizard",
  "identifier": "ai.coreinfra.wizard",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "wizard-ui"
    },
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "wizard-ui"
    },
    "frontendDist": "wizard-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "CoreInfra Wizard",
        "create": false,
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "base-uri": ["'none'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost"],
        "font-src": ["'self'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"],
        "img-src": ["'self'", "data:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"]
      },
      "devCsp": {
        "default-src": ["'self'"],
        "base-uri": ["'none'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "ws:", "wss:"],
        "font-src": ["'self'"],
        "form-action": ["'none'"],
        "frame-ancestors": ["'none'"],
        "img-src": ["'self'", "data:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "signingIdentity": "-",
      "files": {
        "Library/LaunchAgents/ai.coreinfra.wizard.proxy.plist": "ai.coreinfra.wizard.proxy.plist"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "wizard-ui/src/assets/fonts/Inter-OFL.txt": "licenses/Inter-OFL.txt",
      "wizard-ui/src/assets/fonts/SourceCode-OFL.txt": "licenses/SourceCode-OFL.txt"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/CoreInfraAI/wizard/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NEY4MDg5RkNCQTAxOUMKUldTY0FicjhpWUJQNlhyVWNoUDVIYjkzNDlsTVdmTDFaWFNDc2tlTk80WGg0OVZMajh2Tms5TkkK"
    }
  }
}
